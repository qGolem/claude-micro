{
  "name": "codex-micro-protocol",
  "version": "0.2.0",
  "description": "Pure, dependency-free codec for the Work Louder Codex Micro vendor HID RPC protocol: framing, RPC envelopes, lighting payloads, and input-event parsing.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "test": "bun test"
  },
  "keywords": [
    "codex-micro",
    "work-louder",
    "hid",
    "protocol",
    "codec",
    "typescript"
  ],
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  }
}
