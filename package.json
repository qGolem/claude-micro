{
  "name": "claude-micro-bridge",
  "private": true,
  "version": "0.2.0",
  "description": "macOS tmux bridge for the Work Louder Codex Micro and Claude Code.",
  "engines": {
    "node": ">=20"
  },
  "files": [
    ".claude-plugin/plugin.json",
    ".claude-plugin/marketplace.json",
    "claude-micro.tmux",
    "docs/codex-micro.svg",
    "hooks/hooks.json",
    "src/cleanup-legacy.mjs",
    "src/daemon.mjs",
    "src/doctor.mjs",
    "src/event.mjs",
    "src/focus-slot.mjs",
    "src/micro.mjs",
    "src/protocol.mjs",
    "src/state.mjs",
    "src/tmux-reset-bridge.sh",
    "src/tmux-start-bridge.sh",
    "src/tmux-status.mjs",
    "src/tmux-stop-bridge.sh",
    "README.md"
  ],
  "keywords": [
    "claude-code",
    "tmux",
    "codex-micro",
    "work-louder",
    "macos"
  ],
  "type": "module",
  "scripts": {
    "start": "node src/daemon.mjs",
    "event": "node src/event.mjs",
    "cleanup-legacy": "node src/cleanup-legacy.mjs",
    "doctor": "node src/doctor.mjs",
    "check": "node --check src/*.mjs && bash -n claude-micro.tmux && zsh -n src/tmux-*.sh",
    "verify": "npm run check && npm test",
    "test": "node --test"
  },
  "dependencies": {
    "node-hid": "^3.2.0"
  }
}
